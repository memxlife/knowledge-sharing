{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-value-network/schema/paper-value-record-extraction/v0.1",
  "title": "Paper Value Record (extraction output, v0.1)",
  "description": "What the extraction skill produces. The node later adds paper_vector, author_node_id, created_at and the signature. Unknown fields are ignored by nodes.",
  "type": "object",
  "required": [
    "paper_id", "title", "authors", "date", "problem", "contribution", "method_summary",
    "evidence", "builds_on", "useful_for", "limitations", "topics", "extractor"
  ],
  "properties": {
    "paper_id": {
      "type": "string",
      "description": "arXiv ID (no version) or DOI",
      "pattern": "^((arXiv:)?\\d{4}\\.\\d{4,5}(v\\d+)?|(arXiv:)?[a-z\\-]+(\\.[A-Za-z]{2})?/\\d{7}(v\\d+)?|(doi:)?10\\.\\d{4,9}/\\S+)$"
    },
    "title": {"type": "string", "minLength": 1},
    "authors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "date": {"type": "string", "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"},
    "problem": {"type": "string", "minLength": 1, "description": "One or two sentences, at most 40 words."},
    "contribution": {"type": "string", "minLength": 1, "description": "Two to four sentences, at most 90 words."},
    "method_summary": {"type": "string", "minLength": 1, "description": "At most 150 words (checked by the node)."},
    "evidence": {"type": "string", "pattern": "^(Strong|Moderate|Preliminary): .+"},
    "builds_on": {"type": "array", "maxItems": 5, "items": {"type": "string", "minLength": 1}},
    "useful_for": {
      "type": "array", "minItems": 2, "maxItems": 5,
      "items": {"type": "string", "pattern": "^A researcher working on .+ could use this to .+"}
    },
    "limitations": {"type": "string", "minLength": 1},
    "topics": {"type": "array", "minItems": 3, "maxItems": 8, "items": {"type": "string", "minLength": 1}},
    "extractor": {"type": "string", "minLength": 1}
  }
}
